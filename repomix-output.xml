.lote-columna span {
  display: block;

  color: #8a938f;
  font-size: 6px;
  margin-top: 3px;
}

.lote-columna strong {
  display: block;

  color: #33453d;
  font-size: 8px;
  margin-top: 1px;
}

.lote-columna-destacada {
