          <div className="firma">

            <div className="firma-linea" />

            <span>
              Firma y aclaración — Alba Lana
            </span>

          </div>

          <div className="firma">

            <div className="firma-linea" />

            <span>
              Firma y aclaración — {cliente}
            </span>

          </div>

        </section>

      </main>

    </div>
  );
};

export default ConsultarItemsRemito;
