}

.lote-columna-destacada strong:first-of-type {
  color: #d23e3e;
}

.estado-maduracion {
  color: #33453d !important;
}

/* ============================================================
   CARGANDO / ERROR
============================================================ */

.remito-cargando,
.remito-error,
.remito-vacio {
  padding: 20px;
  text-align: center;
  color: #777;
}

.remito-error {
  color: #c0392b;
}

/* ============================================================
   FIRMAS
============================================================ */

.remito-firmas {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18px;

  margin-top: 28px;
}

.firma {
  text-align: center;
}

.firma-linea {
  border-top: 1px solid #d6dbd8;
  margin-bottom: 4px;
}

.firma span {
  color: #858d89;
  font-size: 7px;
}

/* ============================================================
   RESPONSIVE
============================================================ */

@media (max-width: 700px) {

  .remito-documento {
    width: calc(100% - 20px);
    max-width: none;
  }

  .remito-topbar {
    height: auto;
    min-height: 42px;
