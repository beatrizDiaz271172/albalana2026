<file path="frontend/src/pages/RegistrarEgresoRemito.css">
/* Configuración general de la página */
.egreso-page {
  background-color: #f2f5f3;
  min-height: 100vh;
  font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  color: #333;
}

/* Header Verde Superior (misma marca que el resto de la app) */
.navbar-egreso {
  background-color: #276749;
  color: white;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12px 24px;
}

.navbar-brand-egreso {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 1.2rem;
  font-weight: bold;
}

.btn-menu-egreso {
  background-color: rgba(255, 255, 255, 0.15);
  color: white;
  border: 1px solid rgba(255, 255, 255, 0.3);
  padding: 6px 14px;
  border-radius: 4px;
  cursor: pointer;
}

/* Layout del contenedor */
.egreso-container {
  max-width: 800px;
  margin: 0 auto;
  padding: 20px 16px 60px 16px;
}

.nav-actions-egreso {
  display: flex;
  gap: 10px;
  margin-bottom: 12px;
}

.btn-nav-top-egreso {
  background-color: #e2e8f0;
  border: none;
  padding: 6px 14px;
  border-radius: 15px;
  font-size: 0.85rem;
  cursor: pointer;
  color: #4a5568;
}

.btn-nav-top-egreso:hover {
  background-color: #cbd5e0;
}

.screen-title-egreso {
  color: #276749;
  font-size: 1.4rem;
  margin-bottom: 20px;
  display: flex;
  align-items: center;
  gap: 8px;
}

/* Tarjetas (Datos del remito / Ítems del remito) — encabezado en rojo,
   siguiendo el color de "Registrar egreso" del Dashboard */
.card-egreso {
  background-color: #ffffff;
  border-radius: 8px;
  box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
  overflow: hidden;
  margin-bottom: 20px;
}

.card-header-egreso {
  background-color: #d9534f;
  color: white;
  padding: 12px 20px;
  font-weight: 600;
  font-size: 1rem;
}

.card-body-egreso {
  padding: 20px;
}

/* Grillas y campos */
.grid-2 {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16px;
}

.form-group-egreso {
  display: flex;
  flex-direction: column;
  gap: 6px;
  margin-bottom: 16px;
}

.form-group-egreso label {
  font-size: 0.85rem;
  font-weight: 600;
  color: #4a5568;
}

.form-group-egreso input,
.form-group-egreso select,
.form-group-egreso textarea {
  padding: 10px 12px;
  border: 1px solid #cbd5e0;
  border-radius: 6px;
  font-size: 0.95rem;
  outline: none;
  background-color: #fff;
}

.form-group-egreso input:focus,
.form-group-egreso select:focus,
.form-group-egreso textarea:focus {
  border-color: #d9534f;
  box-shadow: 0 0 0 2px rgba(217, 83, 79, 0.2);
}

.ayuda-texto {
  font-size: 0.72rem;
  color: #8b98a5;
}

/* Autocomplete de cliente */
.sugerencias-lista {
  position: absolute;
  top: 100%;
  left: 0;
  right: 0;
  background: white;
  border: 1px solid #cbd5e0;
  border-radius: 6px;
  margin-top: 4px;
  max-height: 200px;
  overflow-y: auto;
  list-style: none;
  padding: 4px 0;
  z-index: 10;
  box-shadow: 0 4px 10px rgba(0, 0, 0, 0.08);
}

.sugerencias-lista li {
  padding: 8px 12px;
  cursor: pointer;
  font-size: 0.9rem;
}

.sugerencias-lista li:hover {
  background-color: #fdecea;
}

/* Tabla de ítems agregados */
.sin-items {
  text-align: center;
  color: #a0aec0;
  font-size: 0.9rem;
  padding: 12px 0;
}

.tabla-items {
  width: 100%;
  border-collapse: collapse;
  margin-bottom: 20px;
  font-size: 0.88rem;
}

.tabla-items th {
  text-align: left;
  color: #4a5568;
  font-size: 0.78rem;
  text-transform: uppercase;
  border-bottom: 2px solid #edf2f7;
  padding: 6px 8px;
}

.tabla-items td {
  padding: 8px;
  border-bottom: 1px solid #edf2f7;
}

.btn-quitar-item {
  background: transparent;
  border: none;
  color: #d9534f;
  font-weight: bold;
  cursor: pointer;
  font-size: 0.9rem;
}

/* Bloque para agregar un ítem nuevo */
.agregar-item-box {
  background-color: #f7f8f9;
  border: 1px dashed #cbd5e0;
  border-radius: 8px;
  padding: 16px;
}

.agregar-item-titulo {
  font-weight: 600;
  color: #276749;
  margin-bottom: 12px;
}

.lote-manual-input {
  margin-top: 6px;
}

.btn-agregar-item {
  width: 100%;
  background-color: #276749;
  color: white;
  border: none;
  padding: 10px;
  border-radius: 6px;
  font-size: 0.9rem;
  font-weight: bold;
  cursor: pointer;
  margin-top: 4px;
  transition: background-color 0.2s;
}

.btn-agregar-item:hover {
  background-color: #1e4e37;
}

/* Botón final de guardado del remito */
.btn-submit-egreso {
  width: 100%;
  background-color: #d9534f;
  color: white;
  border: none;
  padding: 12px;
  border-radius: 6px;
  font-size: 1rem;
  font-weight: bold;
  cursor: pointer;
  transition: background-color 0.2s;
}

.btn-submit-egreso:hover {
  background-color: #c9302c;
}

.btn-submit-egreso:disabled {
  background-color: #e6a5a3;
  cursor: not-allowed;
}

/* Main container para el formulario */
.egreso-main {
  background-color: #f2f5f3;
  min-height: 100vh;
  font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  color: #333;
  padding: 20px 16px 60px 16px;
  max-width: 800px;
  margin: 0 auto;
}

.egreso-main form {
  display: flex;
  flex-direction: column;
  gap: 20px;
}

/* Botón volver */
.btn-back {
  background-color: rgba(255, 255, 255, 0.15);
  color: white;
  border: 1px solid rgba(255, 255, 255, 0.3);
  padding: 8px 16px;
  border-radius: 4px;
  cursor: pointer;
  font-size: 0.9rem;
  transition: background-color 0.2s;
  white-space: nowrap;
}

.btn-back:hover {
  background-color: rgba(255, 255, 255, 0.25);
}

/* Adaptación Responsive */
@media (max-width: 600px) {
  .grid-2 {
    grid-template-columns: 1fr;
  }
  
  .navbar-egreso {
    flex-direction: column;
    gap: 8px;
    align-items: flex-start;
  }
  
  .navbar-egreso h1 {
    font-size: 1.1rem;
    margin-bottom: 8px;
  }
  
  .egreso-main {
    padding: 16px 8px 60px 8px;
  }
}
</file>

<file path="frontend/src/pages/RemitoCliente.css">
/* ============================================================
   PÁGINA REMITO CLIENTE
   ============================================================ */

.remito-cliente-page {
  min-height: 100vh;
  background: linear-gradient(135deg, #f5f5f5 0%, #e8e8e8 100%);
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
}

/* NAVBAR */
.navbar-remito {
  background: linear-gradient(135deg, #2c5f3f 0%, #1e4620 100%);
  color: white;
  padding: 15px 20px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);
  position: sticky;
  top: 0;
  z-index: 100;
}

.navbar-brand-remito {
  display: flex;
  align-items: center;
  gap: 10px;
  font-size: 1.2rem;
  font-weight: 600;
}

.brand-icon {
  font-size: 1.5rem;
}

.brand-title {
  letter-spacing: 0.5px;
}

.btn-menu-remito {
  background: rgba(255, 255, 255, 0.2);
  border: 1px solid rgba(255, 255, 255, 0.3);
  color: white;
  padding: 8px 16px;
  border-radius: 6px;
  cursor: pointer;
  font-size: 0.95rem;
  transition: all 0.3s ease;
}

.btn-menu-remito:hover {
  background: rgba(255, 255, 255, 0.3);
  transform: scale(1.05);
}

/* CONTENEDOR PRINCIPAL */
.remito-cliente-container {
  max-width: 1200px;
  margin: 0 auto;
  padding: 20px;
}

/* ACCIONES DE NAVEGACIÓN */
.nav-actions-remito {
  display: flex;
  gap: 10px;
  margin-bottom: 25px;
}

.btn-nav-top-remito {
  background: white;
  border: 2px solid #2c5f3f;
  color: #2c5f3f;
  padding: 10px 20px;
  border-radius: 6px;
  cursor: pointer;
  font-weight: 500;
  transition: all 0.3s ease;
  font-size: 0.95rem;
}

.btn-nav-top-remito:hover {
  background: #2c5f3f;
  color: white;
  transform: translateY(-2px);
  box-shadow: 0 4px 12px rgba(44, 95, 63, 0.2);
}

/* TÍTULO */
.screen-title-remito {
  font-size: 2rem;
  color: #1e4620;
  margin-bottom: 25px;
  display: flex;
  align-items: center;
  gap: 12px;
}

.title-icon {
  font-size: 2.2rem;
}

/* TARJETA */
.card-remito {
  background: white;
  border-radius: 10px;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
  padding: 20px;
  margin-bottom: 20px;
}

/* SECCIÓN DE FILTRO */
.filtro-section {
  display: flex;
  gap: 15px;
  align-items: center;
  flex-wrap: wrap;
}

.input-filtro {
  flex: 1;
  min-width: 250px;
  padding: 12px 16px;
  border: 2px solid #e0e0e0;
  border-radius: 8px;
  font-size: 1rem;
  transition: all 0.3s ease;
}

.input-filtro:focus {
  outline: none;
  border-color: #2c5f3f;
  box-shadow: 0 0 0 3px rgba(44, 95, 63, 0.1);
}

.badge-contador {
  background: #2c5f3f;
  color: white;
  padding: 8px 16px;
  border-radius: 20px;
  font-weight: 600;
  font-size: 0.9rem;
  white-space: nowrap;
}

/* GRID DE REMITOS */
.remitos-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(500px, 1fr));
  gap: 20px;
  margin-top: 20px;
}

@media (max-width: 768px) {
  .remitos-grid {
    grid-template-columns: 1fr;
  }
}

/* TARJETA INDIVIDUAL DE REMITO */
.remito-card {
  background: white;
  border-radius: 10px;
  box-shadow: 0 2px 12px rgba(0, 0, 0, 0.1);
  overflow: hidden;
  transition: all 0.3s ease;
  display: flex;
  flex-direction: column;
}

.remito-card:hover {
  transform: translateY(-4px);
  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.15);
}

/* ENCABEZADO DE TARJETA */
.remito-card-header {
  background: linear-gradient(135deg, #2c5f3f 0%, #1e4620 100%);
  color: white;
  padding: 16px 20px;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.remito-numero {
  font-size: 1.3rem;
  font-weight: 700;
  letter-spacing: 0.5px;
}

.remito-fecha {
  font-size: 0.9rem;
  opacity: 0.9;
  background: rgba(255, 255, 255, 0.2);
  padding: 6px 12px;
  border-radius: 4px;
}

/* CUERPO DE TARJETA */
.remito-card-body {
  padding: 20px;
  flex: 1;
}

.remito-field {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12px;
  padding-bottom: 12px;
  border-bottom: 1px solid #f0f0f0;
}

.remito-label {
  font-weight: 600;
  color: #666;
  font-size: 0.9rem;
}

.remito-value {
  color: #1e4620;
  font-weight: 600;
  font-size: 1rem;
}

/* ESTADÍSTICAS */
.remito-stats {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12px;
  margin: 20px 0;
  padding: 16px;
  background: #f9f9f9;
  border-radius: 8px;
}

.stat-item {
  display: flex;
  align-items: center;
  gap: 10px;
  text-align: center;
  padding: 8px;
}

.stat-icon {
  font-size: 1.8rem;
}

.stat-content {
  flex: 1;
}

.stat-label {
  display: block;
  font-size: 0.75rem;
  color: #999;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.5px;
}

.stat-number {
  display: block;
  font-size: 1.3rem;
  color: #2c5f3f;
  font-weight: 700;
  margin-top: 4px;
}

/* OBSERVACIONES */
.remito-observaciones {
  margin-top: 16px;
  padding: 12px;
  background: #fffbf0;
  border-left: 4px solid #f09c5a;
  border-radius: 4px;
}

.remito-observaciones .remito-label {
  display: block;
  margin-bottom: 8px;
  color: #f09c5a;
}

.remito-observaciones p {
  margin: 0;
  color: #666;
  font-size: 0.95rem;
  line-height: 1.5;
}

/* DETALLES */
.remito-detalles {
  margin-top: 16px;
  border-top: 1px solid #f0f0f0;
  padding-top: 12px;
}

.detalles-summary {
  cursor: pointer;
  font-weight: 600;
  color: #2c5f3f;
  padding: 8px 0;
  user-select: none;
  transition: color 0.3s ease;
}

.detalles-summary:hover {
  color: #1e4620;
}

.detalles-summary::-webkit-details-marker {
  color: #2c5f3f;
}

/* TABLA DE DETALLES */
.tabla-detalles {
  width: 100%;
  margin-top: 12px;
  border-collapse: collapse;
  font-size: 0.9rem;
}

.tabla-detalles thead {
  background: #f5f5f5;
  border-bottom: 2px solid #e0e0e0;
}

.tabla-detalles th {
  padding: 10px;
  text-align: left;
  font-weight: 600;
  color: #666;
}

.tabla-detalles td {
  padding: 10px;
  border-bottom: 1px solid #f0f0f0;
  color: #333;
}

.tabla-detalles tbody tr:hover {
  background: #f9f9f9;
}

/* PIE DE TARJETA */
.remito-card-footer {
  padding: 16px 20px;
  border-top: 1px solid #f0f0f0;
  background: #fafafa;
}

.btn-ver-detalle {
  width: 100%;
  padding: 12px;
  background: linear-gradient(135deg, #2c5f3f 0%, #1e4620 100%);
  color: white;
  border: none;
  border-radius: 6px;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.3s ease;
  font-size: 0.95rem;
}

.btn-ver-detalle:hover {
  transform: scale(1.02);
  box-shadow: 0 4px 12px rgba(44, 95, 63, 0.3);
}

.btn-ver-detalle:active {
  transform: scale(0.98);
}

/* RESPONSIVE */
@media (max-width: 768px) {
  .navbar-remito {
    padding: 12px 15px;
  }

  .screen-title-remito {
    font-size: 1.5rem;
  }

  .remito-cliente-container {
    padding: 12px;
  }

  .remito-card-header {
    flex-direction: column;
    align-items: flex-start;
    gap: 8px;
  }

  .remito-stats {
    grid-template-columns: repeat(2, 1fr);
  }

  .filtro-section {
    flex-direction: column;
  }

  .input-filtro {
    min-width: 100%;
  }

  .badge-contador {
    width: 100%;
    text-align: center;
  }

  .remito-field {
    flex-direction: column;
    align-items: flex-start;
    gap: 6px;
  }
}

/* ============================================================
   PÁGINA
============================================================ */

.remito-page {
  min-height: 100vh;
  background: #ffffff;
  color: #333;
  font-family: Arial, Helvetica, sans-serif;
  font-size: 12px;
}

/* ============================================================
   BARRA SUPERIOR
============================================================ */

.remito-topbar {
  height: 34px;
  background: #276b4e;
  color: white;

  display: flex;
  align-items: center;
  justify-content: space-between;

  padding: 0 12px;

  box-sizing: border-box;
}

.remito-topbar-title {
  font-size: 12px;
  font-weight: bold;
}

.remito-topbar-icon {
  margin-right: 5px;
}

.remito-topbar-actions {
  display: flex;
  gap: 6px;
}

.remito-btn-volver,
.remito-btn-print {
  border: 0;
  border-radius: 5px;
  cursor: pointer;

  height: 25px;
  padding: 0 12px;

  font-size: 11px;
  font-weight: 500;
}

.remito-btn-volver {
  background: #4d846a;
  color: white;
}

.remito-btn-print {
  background: white;
  color: #276b4e;
}

/* ============================================================
   DOCUMENTO
============================================================ */

.remito-documento {
  width: 680px;
  max-width: calc(100% - 30px);

  margin: 16px auto 25px auto;
}

/* ============================================================
   ENCABEZADO
============================================================ */

.remito-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
}

.remito-empresa h1 {
  margin: 0 0 4px 0;

  color: #276b4e;
  font-size: 17px;
  font-weight: bold;
}

.remito-empresa div {
  color: #7a8580;
  font-size: 8px;
  line-height: 13px;
}

.remito-identificacion {
  text-align: right;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}

.remito-identificacion span {
  font-size: 7px;
  color: #7c8983;
  letter-spacing: 1px;
}

.remito-identificacion strong {
  color: #276b4e;
  font-size: 17px;
  letter-spacing: 1px;
}

.remito-identificacion small {
  color: #666;
  font-size: 8px;
  margin-top: 2px;
}

/* ============================================================
   SEPARADOR
============================================================ */

.remito-separador {
  height: 2px;
  background: #276b4e;
  margin: 10px 0;
}

/* ============================================================
   DATOS GENERALES
============================================================ */

.remito-datos-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 5px 10px;
}

.remito-dato {
  background: #f0f3f0;
  border-radius: 5px;

  min-height: 31px;
  padding: 5px 8px;

  box-sizing: border-box;
}

.remito-dato span {
  display: block;

  font-size: 6px;
  color: #78847f;
  font-weight: bold;
  margin-bottom: 2px;
}

.remito-dato strong {
  display: block;

  color: #283b33;
  font-size: 9px;
}

/* ============================================================
   SECCIONES
============================================================ */

.remito-seccion {
  margin-top: 11px;
}

.remito-seccion h2 {
  margin: 0;

  padding: 0 0 4px 0;

  border-bottom: 2px solid #83b59f;

  color: #276b4e;

  font-size: 8px;
  font-weight: bold;
  letter-spacing: 1px;
}

/* ============================================================
   TABLA
============================================================ */

.remito-tabla-wrapper {
  width: 100%;
  overflow-x: auto;
}

.remito-tabla {
  width: 100%;
  border-collapse: collapse;

  font-size: 8px;
}

.remito-tabla thead {
  background: #276b4e;
  color: white;
}

.remito-tabla th {
  padding: 4px 5px;

  text-align: left;

  font-size: 7px;
  font-weight: bold;

  white-space: nowrap;
}

.remito-tabla td {
  padding: 5px;

  border-bottom: 1px solid #e5e8e6;

  color: #4f5955;
  vertical-align: middle;
}

.remito-tabla td.numero {
  text-align: center;
}

.remito-tabla .producto-principal {
  color: #31463d;
  font-weight: bold;
}

.remito-tabla .fecha-consumo {
  color: #d23e3e;
  font-weight: bold;
  white-space: nowrap;
}

.remito-tabla tfoot td {
  border-bottom: 0;
  padding-top: 5px;
}

.total-label {
  font-weight: bold;
  color: #263e34 !important;
}

.total {
  font-weight: bold;
  color: #263e34 !important;
}

/* ============================================================
   MADUREZ
============================================================ */

.madurez-contenedor {
  display: flex;
  align-items: center;
  gap: 5px;
}

.madurez-barra {
  width: 48px;
  height: 6px;

  background: #dfe5e1;
