/* ============================================================
   ESTILOS AMPLIADOS PARA EL REMITO
   ============================================================ */

/* Contenedor general de la página */
.remito-page {
  background-color: #eef2f5;
  min-height: 100vh;
  padding: 30px 20px;
  display: flex;
  flex-direction: column;
  align-items: center;
}

/* Barra superior de acciones (No se imprime) */
/* ============================================================
   BARRA SUPERIOR AMPLIADA
   ============================================================ */
.remito-topbar {
  width: 100%;
  max-width: 1500px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: #2c5f3f;
  color: white;
  padding: 40px 30px;
  border-radius: 10px;
  margin-bottom: 30px;
  box-shadow: 0 6px 16px rgba(0, 0, 0, 0.18);
  box-sizing: border-box;
}

.remito-topbar-title {
  font-size: 1.7rem;
  font-weight: 700;
  display: flex;
  align-items: center;
  gap: 12px;
  margin: 0;
}

.remito-topbar-actions {
  display: flex;
  align-items: center;
  gap: 18px;
}

.remito-btn-volver,
.remito-btn-print {
  background: rgba(255, 255, 255, 0.22);
  border: 1px solid rgba(255, 255, 255, 0.45);
  color: white;
  padding: 12px 22px;
  border-radius: 8px;
  font-weight: 700;
  cursor: pointer;
  font-size: 1.1rem;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s ease;
  line-height: normal;
}

.remito-btn-volver:hover,
.remito-btn-print:hover {
  background: rgba(255, 255, 255, 0.38);
  transform: translateY(-2px);
}

/* DOCUMENTO PRINCIPAL (Ampliado) */
.remito-documento {
  width: 100%;
  max-width: 1350px;
  background: white;
  padding: 50px;
  border-radius: 10px;
  box-shadow: 0 6px 25px rgba(0, 0, 0, 0.12);
  font-size: 1.1rem; /* Base tipográfica aumentada */
}

/* Encabezado */
.remito-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 20px;
}

.remito-empresa h1 {
  font-size: 2.5rem;
  color: #2c5f3f;
  margin: 0 0 8px 0;
}

.remito-empresa div {
  font-size: 1.05rem;
  color: #555;
  line-height: 1.4;
}


/* Línea separadora */
.remito-separador {
  width: 100%;
  height: 3px;
  background-color: #2c5f3f;
  margin-bottom: 30px;
}

/* Cuadrícula de datos generales */
.remito-datos-grid {
  display: grid;
  grid-template-columns: 2fr 1fr 1fr 1fr;
  gap: 20px;
  margin-bottom: 35px;
}

.remito-dato {
  background: #f8f9fa;
  border: 1px solid #e2e8f0;
  border-radius: 8px;
  padding: 15px 20px;
}

.remito-dato span {
  font-size: 0.8rem;
  color: #64748b;
  text-transform: uppercase;
  font-weight: 700;
  display: block;
  margin-bottom: 5px;
}

.remito-dato strong {
  font-size: 1.25rem;
  color: #1e293b;
}

/* Secciones y Tablas */
.remito-seccion {
  margin-bottom: 40px;
}

.remito-seccion h2 {
  font-size: 1.4rem;
  color: #2c5f3f;
  margin-bottom: 15px;
  border-bottom: 2px solid #e2e8f0;
